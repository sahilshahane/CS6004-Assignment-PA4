{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run script",
			"type": "shell",
			"command": "./run.sh",
			"args": [
				"--compile-only",
				"${input:testName}"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	],
	"inputs": [
		{
			"id": "testName",
			"type": "promptString",
			"description": "Enter test case name (e.g., Test1, Test2)",
			"default": "Test1"
		}
	]
}